# Server Configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=text

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=mentorship-task-golang
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_LIFETIME=5m

# Server Timeouts
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# JWT Configuration (if using auth)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ISSUER=mentorship-task-golang
JWT_EXPIRY=24h

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DB_DSN}
GOOSE_MIGRATION_DIR=./migrations
GOOSE_TABLE=goose_migrations

MIGRATIONS_DIR=${GOOSE_MIGRATION_DIR}

# External Services (uncomment as needed)
# REDIS_URL=redis://localhost:6379
# ELASTICSEARCH_URL=http://localhost:9200
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
